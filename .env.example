# ══════════════════════════════════════════════════════
#  BOIMELA — Book Exchange Platform
#  Environment Variables Example
#  Rename this file to .env and customize for your environment.
#  THIS FILE IS SAFE TO COMMIT (contains no real credentials)
# ══════════════════════════════════════════════════════

# -- PostgreSQL Database Configuration --------------------
POSTGRES_DB=boimela
POSTGRES_USER=boimela_user
POSTGRES_PASSWORD=change_me_in_production

# Spring datasource vars consumed by application.yml
DB_URL=jdbc:postgresql://db:5432/boimela
DB_USER=boimela_user
DB_PASSWORD=change_me_in_production

# -- Spring profile ----------------------------------------
# 'prod'  -> minimal logging, no SQL output, optimized
# 'dev'   -> verbose logging, formatted SQL, debug mode
SPRING_PROFILES_ACTIVE=dev

# -- Application Server Configuration ---------------------
PORT=8080
SERVER_PORT=8080

# -- Hibernate/JPA Configuration ---------------------------
# 'update'  -> auto-create/update schema (safe for dev)
# 'validate'-> only validate schema exists (prod)
JPA_HIBERNATE_DDL_AUTO=update

# -- Logging Configuration --------------------------------
# DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_PROJECT_BOIMELA=DEBUG

# -- Docker & Container Settings --------------------------
COMPOSE_PROJECT_NAME=boimela
CONTAINER_REGISTRY=docker.io

# -- Security & Authentication ---------------------------
# Use strong passwords in production!
# Min 12 characters recommended
# JWT_SECRET can be generated with: openssl rand -base64 32
# JWT_EXPIRATION in milliseconds (86400000 = 24 hours)
# Uncomment these for JWT implementation if added later:
# JWT_SECRET=your-secret-key-here-minimum-32-chars
# JWT_EXPIRATION=86400000

# -- Deployment Environment Variables ---------------------
# Set to 'true' for production, 'false' for development
IS_PRODUCTION=false

# -- Optional: Render Deployment --------------------------
# Required for GitHub Actions CI/CD deployment to Render
# Add this in GitHub Repository Settings → Secrets
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxx?key=xxxxx
